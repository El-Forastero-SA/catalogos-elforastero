{
  "cleanUrls": true,
  "functions": {
    "api/zip.js": { "maxDuration": 300 },
    "api/download.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/thumbs/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
  ]
}
